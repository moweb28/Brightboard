{
  // The Brightboard connection service: rooms, room passes and media, nothing stored.
  // Everything here fits Cloudflare's free plan (Workers Free, SQLite-backed Durable Objects, Realtime SFU free allowance).
  "name": "brightboard",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  // Served at https://brightboard.<your-subdomain>.workers.dev (no custom domain needed).
  "workers_dev": true,
  // The website (people join from a phone or any browser): build it first with
  // `npm run build:web -w @classroom/desktop`. The paths listed run the relay code; everything else is the site.
  "assets": {
    "directory": "../desktop/out/web",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/room/*", "/partytracks/*", "/j/*", "/health"]
  },
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "Room" }]
  },
  // SQLite-backed classes are the kind the free plan allows. Rooms never write to storage anyway.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }],
  // Where the invite page sends people without the app (the GitHub Releases page, once there is one).
  "vars": { "DOWNLOAD_URL": "https://github.com/moweb28/Brightboard/releases/latest" }
  // Secrets (set with `npx wrangler secret put NAME`, or in .dev.vars for local runs):
  //   SFU_APP_ID, SFU_APP_TOKEN, TICKET_SECRET, and optionally TURN_APP_ID, TURN_APP_TOKEN
}
