# Security headers for the website (served by the relay). The desktop app ignores this file.
# The policy only allows what Brightboard uses: its own files and connection service, plus the
# camera-background and handwriting engines (jsdelivr, Google's model file, tessdata).
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval' https://cdn.jsdelivr.net/npm/@mediapipe/ https://cdn.jsdelivr.net/npm/tesseract.js@ https://cdn.jsdelivr.net/npm/tesseract.js-core@; worker-src 'self' blob:; connect-src 'self' https://cdn.jsdelivr.net/npm/@mediapipe/ https://cdn.jsdelivr.net/npm/tesseract.js@ https://cdn.jsdelivr.net/npm/tesseract.js-core@ https://storage.googleapis.com/mediapipe-models/ https://tessdata.projectnaptha.com data: blob:; img-src 'self' data: blob:; media-src 'self' blob: mediastream:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  X-Frame-Options: DENY
  Strict-Transport-Security: max-age=31536000
  Cross-Origin-Opener-Policy: same-origin
  Permissions-Policy: camera=(self), microphone=(self), display-capture=(self), fullscreen=(self), clipboard-write=(self), geolocation=(), payment=(), usb=()
