{
  "name": "classroom",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "npm test --workspaces --if-present",
    "dev:relay": "npm run dev -w @classroom/relay",
    "dev:desktop": "npm run dev -w @classroom/desktop",
    "build:win": "npm run dist -w @classroom/desktop"
  },
  "allowScripts": {
    "electron@38.8.6": true,
    "esbuild@0.28.2": true,
    "esbuild@0.25.12": true,
    "protobufjs": false,
    "tesseract.js": false,
    "workerd@1.20261006.1": true
  }
}
